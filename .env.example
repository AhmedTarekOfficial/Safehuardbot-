# Keep this private. Never commit the real token.
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
# Optional: instant slash command sync in one development server.
# Remove for global commands (may take time to appear).
DEV_GUILD_ID=
# Required on Railway: set this to a file inside the mounted Volume.
# With a Volume mounted at /app/data:
# SENTINEL_DB_PATH=/app/data/sentinel.sqlite3
